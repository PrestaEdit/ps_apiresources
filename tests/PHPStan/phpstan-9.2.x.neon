includes:
    - %currentWorkingDirectory%/tests/PHPStan/phpstan.neon

parameters:
    tmpDir: %currentWorkingDirectory%/var/phpstan-tmp/9.2.x
    ignoreErrors:
        # BusinessEntity domain only exists on develop; gated via experimentalOperation.
        -
            message: "#Class .*BusinessEntity\\\\(Command|Exception).* not found.#"
            identifier: class.notFound
            count: 4
            path: ../../src/ApiPlatform/Resources/BusinessEntity/BusinessEntity.php
